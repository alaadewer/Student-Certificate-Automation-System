    {
      "parameters": {
        "jsCode": "const TEMPLATE_VERSION = 'v2';   // change when the template changes\nconst COURSE = '';               // leave empty for all courses, or enter a course name\nreturn $input.all().map(i => i.json)\n  .filter(r => r.cert_id && r.status === 'issued' && r.template_version !== TEMPLATE_VERSION &&\n               (!COURSE || r.course === COURSE))\n  .slice(0, 20)\n  .map(r => ({ json: { cert_id: r.cert_id, name: r.name, email: r.email, course: r.course, score: r.score, mode: 'backfill' } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
