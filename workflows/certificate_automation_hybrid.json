    {
      "parameters": {
        "jsCode": "const now = Date.now();\nreturn $input.all().map(i => i.json)\n  .filter(r => r.cert_id && ['pending', 'failed'].includes(r.status) &&\n               (now - new Date(r.created_at).getTime()) / 60000 > 15)\n  .slice(0, 20)   // small batch to protect API limits\n  .map(r => ({ json: { cert_id: r.cert_id, name: r.name, email: r.email, course: r.course, score: r.score, mode: 'issue' } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        646
      ],
      "id": "e1eaa54a-0bd8-46cd-8706-1bdb6c722aac",
      "name": "Find Pending"
    },
