    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst name = String(f['Full Name'] || '').trim();\nconst email = String(f['Email'] || '').trim().toLowerCase();\nconst course = String(f['Course'] || '').trim();\nconst score = Number(f['Score']);\nconst slug = s => s.toLowerCase().replace(/[^a-z0-9\\u0600-\\u06FF]+/g, '-').replace(/^-|-$/g, '');\nlet error = '';\nif (!name) error = 'Missing name';\nelse if (!/^\\S+@\\S+\\.\\S+$/.test(email)) error = 'Invalid email';\nelse if (isNaN(score) || score < 60) error = 'Score below passing mark (60)';\nreturn [{ json: { cert_id: slug(email) + '_' + slug(course), name, email, course, score,\n  valid: error === '', error, mode: 'issue' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "id": "de7d896c-3023-4f20-ae74-ddad2b816345",
      "name": "Prepare Request"
    },
